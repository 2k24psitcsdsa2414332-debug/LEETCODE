from functools import lru_cache

class Solution:
    def minimumTotalDistance(self, robot, factory):
        robot.sort()
        factory.sort()
        
        n, m = len(robot), len(factory)
        
        @lru_cache(None)
        def dp(i, j):
            # If all robots are assigned
            if i == n:
                return 0
            
            # If no factories left but robots remain
            if j == m:
                return float('inf')
            
            res = dp(i, j + 1)  # skip current factory
            
            pos, cap = factory[j]
            dist = 0
            
            # Try assigning k robots to this factory
            for k in range(1, cap + 1):
                if i + k > n:
                    break
                
                dist += abs(robot[i + k - 1] - pos)
                res = min(res, dist + dp(i + k, j + 1))
            
            return res
        
        return dp(0, 0)
