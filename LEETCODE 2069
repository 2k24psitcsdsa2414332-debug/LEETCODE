class Robot:

    def __init__(self, width: int, height: int):
        self.w = width
        self.h = height
        self.perimeter = 2 * (width + height) - 4
        self.steps = 0
        self.moved = False   # ✅ track movement

    def step(self, num: int) -> None:
        self.steps = (self.steps + num) % self.perimeter
        self.moved = True   # ✅ mark that robot has moved

    def getPos(self):
        s = self.steps
        
        if s < self.w:
            return [s, 0]
        s -= self.w

        if s < self.h - 1:
            return [self.w - 1, s + 1]
        s -= (self.h - 1)

        if s < self.w - 1:
            return [self.w - 2 - s, self.h - 1]
        s -= (self.w - 1)

        return [0, self.h - 2 - s]

    def getDir(self):
        # ✅ FIXED CONDITION
        if self.steps == 0:
            return "South" if self.moved else "East"
        
        s = self.steps
        
        if s < self.w:
            return "East"
        s -= self.w

        if s < self.h - 1:
            return "North"
        s -= (self.h - 1)

        if s < self.w - 1:
            return "West"

        return "South"
