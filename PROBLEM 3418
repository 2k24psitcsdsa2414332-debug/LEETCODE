class Solution:
    def maximumAmount(self, grid):
        from math import inf
        
        m, n = len(grid), len(grid[0])
        dp = [[[-inf] * 3 for _ in range(n)] for _ in range(m)]
        
        dp[0][0][0] = grid[0][0]
        if grid[0][0] < 0:
            dp[0][0][1] = 0
        
        for i in range(m):
            for j in range(n):
                for k in range(3):
                    if dp[i][j][k] == -inf:
                        continue
                    
                    for ni, nj in [(i+1, j), (i, j+1)]:
                        if ni < m and nj < n:
                            val = grid[ni][nj]
                            
                            dp[ni][nj][k] = max(dp[ni][nj][k],
                                                dp[i][j][k] + val)
                            
                            if val < 0 and k < 2:
                                dp[ni][nj][k+1] = max(dp[ni][nj][k+1],
                                                      dp[i][j][k])
        
        return max(dp[m-1][n-1])
