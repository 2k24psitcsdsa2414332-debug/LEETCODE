class Solution:
    def canPartitionGrid(self, grid):
        total = sum(sum(row) for row in grid)

        if total % 2 != 0:
            return False

        target = total // 2

        # Check horizontal cut
        curr = 0
        for i in range(len(grid) - 1):
            curr += sum(grid[i])
            if curr == target:
                return True

        # Check vertical cut
        curr = 0
        n = len(grid[0])
        for j in range(n - 1):
            for i in range(len(grid)):
                curr += grid[i][j]
            if curr == target:
                return True

        return False
