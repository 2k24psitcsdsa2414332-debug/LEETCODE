from bisect import bisect_left, bisect_right
from functools import lru_cache

class Solution:
    def maxWalls(self, robots, distance, walls):
        n = len(robots)
        
        arr = sorted(zip(robots, distance))
        walls.sort()
        
        @lru_cache(None)
        def dfs(i, dir):
            if i < 0:
                return 0
            
            r, d = arr[i]
            
            # LEFT
            left = r - d
            if i > 0:
                left = max(left, arr[i-1][0] + 1)
            
            l = bisect_left(walls, left)
            r_idx = bisect_left(walls, r + 1)
            left_count = r_idx - l
            
            res = dfs(i-1, 0) + left_count
            
            # RIGHT
            right = r + d
            if i < n - 1:
                if dir == 0:
                    right = min(right, arr[i+1][0] - arr[i+1][1] - 1)
                else:
                    right = min(right, arr[i+1][0] - 1)
            
            l = bisect_left(walls, r)
            r_idx = bisect_left(walls, right + 1)
            right_count = r_idx - l
            
            res = max(res, dfs(i-1, 1) + right_count)
            
            return res
        
        return dfs(n-1, 1)
