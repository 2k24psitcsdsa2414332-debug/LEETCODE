class Solution:
    def minimumDistance(self, word: str) -> int:
        from functools import lru_cache

        def dist(a, b):
            if a == -1 or b == -1:
                return 0
            return abs(a // 6 - b // 6) + abs(a % 6 - b % 6)

        n = len(word)
        word = [ord(c) - ord('A') for c in word]

        @lru_cache(None)
        def dp(i, f1, f2):
            if i == n:
                return 0
            
            curr = word[i]

            # Option 1: move finger1
            op1 = dist(f1, curr) + dp(i + 1, curr, f2)

            # Option 2: move finger2
            op2 = dist(f2, curr) + dp(i + 1, f1, curr)

            return min(op1, op2)

        return dp(0, -1, -1)
